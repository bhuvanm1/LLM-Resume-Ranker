# FREE LOCAL MODE (recommended): install Ollama, then run
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
# and leave ANTHROPIC_API_KEY empty. Nothing else to configure.
# Copy to .env. Everything is optional: with no keys the app still runs
# using local heuristics + TF-IDF embeddings.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# auto | sbert | tfidf   (auto = use sentence-transformers if installed)
EMBEDDING_BACKEND=auto
SBERT_MODEL=all-MiniLM-L6-v2
# Final score = W_SEMANTIC*semantic + W_SKILLS*skills + W_EXPERIENCE*experience
W_SEMANTIC=0.45
W_SKILLS=0.40
W_EXPERIENCE=0.15

# auto | ollama | anthropic | none
LLM_PROVIDER=auto
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
